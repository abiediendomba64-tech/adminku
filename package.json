{
  "name": "backoffice-telegram-bot",
  "version": "2.2.0",
  "description": "Telegram Bot, D1 REST API, and Adminku Backoffice",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "check": "node --check worker.js && node --check backoffice-api.js",
    "test": "node --test tests/*.test.js",
    "test:migrations": "python3 tests/migration_smoke.py",
    "migrations:local": "npx --yes wrangler@latest d1 migrations apply adminku-db --local",
    "dev": "npx --yes wrangler@latest dev",
    "dry-run": "npx --yes wrangler@latest deploy --dry-run",
    "deploy": "npx --yes wrangler@latest deploy"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
